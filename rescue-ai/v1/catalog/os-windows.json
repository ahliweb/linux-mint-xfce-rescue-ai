{
  "catalog_version": "1",
  "domain": "os-windows",
  "actions": [
    {
      "action_id": "os-windows.sfc-verify",
      "title": "Check protected Windows system files without repairing (sfc /verifyonly)",
      "title_id": "Periksa file sistem Windows tanpa memperbaiki (sfc /verifyonly)",
      "scope": "os",
      "platforms": [
        "windows-host"
      ],
      "target_families": [
        "windows"
      ],
      "risk": "safe",
      "requires_root": true,
      "triggers": [
        {
          "check_id": "windows-system-files",
          "status": [
            "warn",
            "unknown"
          ]
        }
      ],
      "execute": {
        "argv": [
          "sfc.exe",
          "/verifyonly"
        ],
        "timeout_seconds": 3600
      },
      "verify": {
        "argv": [
          "sfc.exe",
          "/verifyonly"
        ],
        "timeout_seconds": 3600
      },
      "rollback": {
        "kind": "none"
      },
      "backup": {
        "required": false
      },
      "doc": "docs/os-repair.md#windows-sfc"
    },
    {
      "action_id": "os-windows.sfc-scannow",
      "title": "Repair protected Windows system files (sfc /scannow)",
      "title_id": "Perbaiki file sistem Windows yang dilindungi (sfc /scannow)",
      "scope": "os",
      "platforms": [
        "windows-host"
      ],
      "target_families": [
        "windows"
      ],
      "risk": "destructive",
      "requires_root": true,
      "triggers": [
        {
          "check_id": "windows-system-files",
          "status": [
            "warn"
          ]
        }
      ],
      "execute": {
        "argv": [
          "sfc.exe",
          "/scannow"
        ],
        "timeout_seconds": 3600
      },
      "verify": {
        "argv": [
          "sfc.exe",
          "/verifyonly"
        ],
        "timeout_seconds": 3600
      },
      "rollback": {
        "kind": "manual",
        "doc": "docs/os-repair.md#rollback-windows"
      },
      "backup": {
        "required": true,
        "what": "system-restore-point"
      },
      "doc": "docs/os-repair.md#windows-sfc"
    },
    {
