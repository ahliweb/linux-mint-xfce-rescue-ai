{
  "catalog_version": "1",
  "domain": "os-linux",
  "actions": [
    {
      "action_id": "os-linux.dpkg-configure-pending",
      "title": "Finish half-configured packages in the offline Linux system (chroot dpkg --configure -a)",
      "title_id": "Selesaikan konfigurasi paket setengah jadi pada Linux offline (chroot dpkg --configure -a)",
      "scope": "os",
      "platforms": [
        "live-linux"
      ],
      "target_families": [
        "linuxmint",
        "linux-other"
      ],
      "risk": "destructive",
      "requires_root": true,
      "requires_target_rw": true,
      "triggers": [
        {
          "check_id": "linux-package-state",
          "status": [
            "fail",
            "warn"
          ]
        },
        {
          "check_id": "linux-dpkg-lock",
          "status": [
            "warn"
          ]
        }
      ],
      "params": [
        {
          "name": "target_root",
          "type": "target_root"
        }
      ],
      "preconditions": [
        {
          "argv": [
            "chroot",
            "{target_root}",
            "dpkg",
            "--version"
          ]
        }
      ],
      "execute": {
        "argv": [
          "chroot",
          "{target_root}",
          "dpkg",
          "--configure",
          "-a"
        ],
        "timeout_seconds": 1800
      },
      "verify": {
        "argv": [
          "chroot",
          "{target_root}",
          "apt-get",
          "check",
          "-q"
        ]
      },
      "rollback": {
        "kind": "restore-backup",
        "doc": "docs/os-repair.md#rollback-linux"
      },
      "backup": {
        "required": true,
        "what": "package-state"
      },
      "doc": "docs/os-repair.md#linux-dpkg-configure"
    },
    {
      "action_id": "os-linux.initramfs-create",
      "title": "Create missing initramfs images in the offline Linux system (chroot update-initramfs -c)",
      "title_id": "Buat initramfs yang hilang pada Linux offline (chroot update-initramfs -c)",
      "scope": "os",
      "platforms": [
        "live-linux"
      ],
      "target_families": [
        "linuxmint",
        "linux-other"
      ],
      "risk": "destructive",
      "requires_root": true,
      "requires_target_rw": true,
      "triggers": [
        {
          "check_id": "linux-kernel-initrd",
          "status": [
            "fail"
          ]
        }
      ],
      "params": [
        {
          "name": "target_root",
          "type": "target_root"
        }
      ],
      "preconditions": [
        {
          "argv": [
            "chroot",
            "{target_root}",
            "update-initramfs",
            "-h"
          ]
        }
      ],
      "execute": {
        "argv": [
          "chroot",
          "{target_root}",
          "update-initramfs",
          "-c",
          "-k",
          "all"
        ],
        "timeout_seconds": 900
      },
      "verify": {
        "argv": [
          "chroot",
          "{target_root}",
          "test",
          "-s",
          "/boot/initrd.img"
        ]
      },
      "rollback": {
        "kind": "restore-backup",
        "doc": "docs/os-repair.md#rollback-linux"
      },
      "backup": {
        "required": true,
        "what": "file-copy"
      },
      "doc": "docs/os-repair.md#linux-initramfs"
    },
