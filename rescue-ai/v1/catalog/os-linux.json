    {
      "action_id": "os-linux.apt-fix-broken",
      "title": "Fix broken package dependencies on this Linux (apt-get --fix-broken install)",
      "title_id": "Perbaiki dependensi paket rusak pada Linux ini (apt-get --fix-broken install)",
      "scope": "os",
      "platforms": [
        "linux-host"
      ],
      "target_families": [
        "linuxmint",
        "linux-other"
      ],
      "risk": "destructive",
      "requires_root": true,
      "triggers": [
        {
          "check_id": "linux-package-state",
          "status": [
            "fail"
          ]
        }
      ],
      "execute": {
        "argv": [
          "apt-get",
          "--fix-broken",
          "install",
          "-y",
          "-o",
          "Dpkg::Options::=--force-confold"
        ],
        "timeout_seconds": 1800
      },
      "verify": {
        "argv": [
          "apt-get",
          "check",
          "-q"
        ]
      },
      "rollback": {
        "kind": "restore-backup",
        "doc": "docs/os-repair.md#rollback-linux"
      },
      "backup": {
        "required": true,
        "what": "package-state"
      },
      "doc": "docs/os-repair.md#linux-apt-fix"
    },
    {
      "action_id": "os-linux.restart-failed-units",
      "title": "Restart one failed systemd unit on this Linux",
      "title_id": "Restart satu unit systemd yang gagal pada Linux ini",
      "scope": "os",
      "platforms": [
        "linux-host"
      ],
      "target_families": [
        "linuxmint",
        "linux-other"
      ],
      "risk": "safe",
      "requires_root": true,
      "triggers": [
        {
          "check_id": "linux-failed-units",
          "status": [
            "warn",
            "fail"
          ]
        }
      ],
      "params": [
        {
          "name": "unit",
          "type": "service_name"
        }
      ],
      "execute": {
        "argv": [
          "systemctl",
          "restart",
          "{unit}"
        ],
        "timeout_seconds": 120
      },
      "verify": {
        "argv": [
          "systemctl",
          "is-failed",
          "--quiet",
          "{unit}"
        ],
        "expect_exit": [
          1
        ]
      },
      "rollback": {
        "kind": "none"
      },
      "backup": {
        "required": false
      },
      "doc": "docs/os-repair.md#linux-units"
    }
