{
  "catalog_version": "1",
  "domain": "software",
  "actions": [
    {
      "action_id": "sw.dpkg-configure-pending",
      "title": "Finish configuring half-installed packages (dpkg --configure -a)",
      "title_id": "Selesaikan konfigurasi paket yang tertunda (dpkg --configure -a)",
      "scope": "software",
      "platforms": ["linux-host"],
      "target_families": ["linuxmint", "linux-other"],
      "risk": "destructive",
      "requires_root": true,
      "triggers": [{"check_id": "sw-pending-config", "status": ["warn", "fail"]}],
      "execute": {"argv": ["dpkg", "--configure", "-a"], "timeout_seconds": 1800},
      "verify": {"argv": ["dpkg", "--configure", "-a"], "timeout_seconds": 600},
      "rollback": {"kind": "manual", "doc": "docs/software.md#rollback-dpkg"},
      "backup": {"required": true, "what": "package-state"},
      "doc": "docs/software.md#sw-dpkg-configure-pending"
    },
    {
      "action_id": "sw.apt-fix-broken",
      "title": "Repair broken dependencies (apt-get -f install)",
      "title_id": "Perbaiki dependensi rusak (apt-get -f install)",
      "scope": "software",
      "platforms": ["linux-host"],
      "target_families": ["linuxmint", "linux-other"],
      "risk": "destructive",
      "requires_root": true,
      "triggers": [{"check_id": "sw-broken-dependencies", "status": ["warn", "fail"]}],
      "preconditions": [{"argv": ["apt-get", "-s", "-f", "install"], "timeout_seconds": 120}],
      "execute": {"argv": ["apt-get", "-y", "-f", "install", "-o", "Dpkg::Options::=--force-confold"], "timeout_seconds": 3600},
      "verify": {"argv": ["apt-get", "check"], "timeout_seconds": 120},
      "rollback": {"kind": "manual", "doc": "docs/software.md#rollback-dpkg"},
      "backup": {"required": true, "what": "package-state"},
      "doc": "docs/software.md#sw-apt-fix-broken"
    },
    {
      "action_id": "sw.apt-reinstall-package",
      "title": "Reinstall one package (apt-get install --reinstall)",
      "title_id": "Pasang ulang satu paket (apt-get install --reinstall)",
      "scope": "software",
      "platforms": ["linux-host"],
      "target_families": ["linuxmint", "linux-other"],
      "risk": "destructive",
      "requires_root": true,
      "triggers": [
        {"check_id": "sw-package-health", "status": ["fail"]},
        {"check_id": "sw-package-integrity", "status": ["fail"]}
      ],
      "params": [{"name": "package", "type": "package_name"}],
      "preconditions": [{"argv": ["apt-get", "-s", "install", "--reinstall", "{package}"], "timeout_seconds": 120}],
      "execute": {"argv": ["apt-get", "install", "--reinstall", "-y", "-o", "Dpkg::Options::=--force-confold", "{package}"], "timeout_seconds": 1800},
      "verify": {"argv": ["dpkg", "--verify", "{package}"], "timeout_seconds": 300},
      "rollback": {"kind": "manual", "doc": "docs/software.md#rollback-dpkg"},
      "backup": {"required": true, "what": "package-state"},
      "doc": "docs/software.md#sw-apt-reinstall-package"
    },
    {
      "action_id": "sw.dpkg-configure-target",
      "title": "Finish package configuration on the mounted installed OS",
      "title_id": "Selesaikan konfigurasi paket pada OS terpasang yang di-mount",
      "scope": "software",
      "platforms": ["live-linux"],
      "target_families": ["linuxmint", "linux-other"],
      "risk": "destructive",
      "requires_root": true,
      "requires_target_rw": true,
      "triggers": [{"check_id": "sw-pending-config", "status": ["warn", "fail"]}],
      "params": [{"name": "target_root", "type": "target_root"}],
      "execute": {"argv": ["dpkg", "--root={target_root}", "--configure", "-a"], "timeout_seconds": 1800},
      "verify": {"argv": ["dpkg", "--root={target_root}", "--configure", "-a"], "timeout_seconds": 600},
      "rollback": {"kind": "manual", "doc": "docs/software.md#rollback-dpkg"},
      "backup": {"required": true, "what": "package-state"},
      "doc": "docs/software.md#sw-dpkg-configure-target"
    },
    {
      "action_id": "sw.winget-repair-package",
      "title": "Repair one package with winget",
      "title_id": "Perbaiki satu paket dengan winget",
      "scope": "software",
      "platforms": ["windows-host"],
      "target_families": ["windows"],
      "risk": "destructive",
      "triggers": [{"check_id": "sw-app-health", "status": ["warn", "fail"]}],
      "params": [{"name": "package", "type": "package_name"}],
      "preconditions": [{"argv": ["winget.exe", "list", "--id", "{package}", "--exact", "--disable-interactivity", "--accept-source-agreements"], "timeout_seconds": 60}],
      "execute": {"argv": ["winget.exe", "repair", "--id", "{package}", "--exact", "--disable-interactivity", "--accept-source-agreements"], "timeout_seconds": 3600},
      "verify": {"argv": ["winget.exe", "list", "--id", "{package}", "--exact", "--disable-interactivity", "--accept-source-agreements"], "timeout_seconds": 60},
      "rollback": {"kind": "manual", "doc": "docs/software.md#rollback-winget"},
      "backup": {"required": true, "what": "system-restore-point"},
      "doc": "docs/software.md#sw-winget-repair-package"
    },
    {
      "action_id": "sw.winget-upgrade-package",
      "title": "Upgrade one package with winget",
      "title_id": "Perbarui satu paket dengan winget",
      "scope": "software",
      "platforms": ["windows-host"],
      "target_families": ["windows"],
      "risk": "destructive",
      "triggers": [],
      "params": [{"name": "package", "type": "package_name"}],
      "preconditions": [{"argv": ["winget.exe", "list", "--id", "{package}", "--exact", "--disable-interactivity", "--accept-source-agreements"], "timeout_seconds": 60}],
      "execute": {"argv": ["winget.exe", "upgrade", "--id", "{package}", "--exact", "--disable-interactivity", "--accept-source-agreements"], "timeout_seconds": 3600},
      "verify": {"argv": ["winget.exe", "list", "--id", "{package}", "--exact", "--disable-interactivity", "--accept-source-agreements"], "timeout_seconds": 60},
      "rollback": {"kind": "manual", "doc": "docs/software.md#rollback-winget"},
      "backup": {"required": true, "what": "system-restore-point"},
      "doc": "docs/software.md#sw-winget-upgrade-package"
    }
  ]
}
