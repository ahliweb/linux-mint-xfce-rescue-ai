# Copy to config/rescue.env and chmod 600.
# The command must read sanitized evidence from stdin and write a JSON/text report to stdout.
# Example: OPENCODE_ADAPTER_COMMAND='opencode run --model <provider-model>'
# Keep provider authentication in the OpenCode credential store or environment, never in evidence.json.
OPENCODE_ADAPTER_COMMAND=''
OPENCODE_TIMEOUT_SECONDS=120
